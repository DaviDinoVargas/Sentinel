{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.dev/schemas/plugin-execution-result.schema.json",
  "title": "Sentinel PluginExecutionResult",
  "type": "object",
  "required": ["contractVersion", "outcome", "checks", "evidence", "warnings"],
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["Succeeded", "Failed", "Partial", "Inconclusive", "Cancelled", "TimedOut"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["controlId", "state", "summary", "confidence", "severity"],
        "properties": {
          "controlId": { "type": "string", "minLength": 1 },
          "state": { "enum": ["Passed", "Failed", "Inconclusive", "NotTested", "Blocked", "Pending", "Informational", "ScriptError"] },
          "summary": { "type": "string" },
          "confidence": { "enum": ["Reproduced", "Confirmed-by-inspection", "Inferred", "Hypothesis", "NotAssessed", "DemonstrationOnly"] },
          "severity": { "enum": ["Critical", "High", "Medium", "Low", "Info"] },
          "location": { "type": ["null", "string"], "maxLength": 768 },
          "sourceRuleId": { "type": ["null", "string"], "maxLength": 128 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "evidenceSummary"],
        "properties": {
          "summary": { "type": "string" },
          "evidenceSummary": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
