{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.dev/schemas/plugin-execution-request.schema.json",
  "title": "Sentinel PluginExecutionRequest",
  "type": "object",
  "required": ["contractVersion", "executionId", "auditId", "projectId", "scopeId", "correlationId", "targetUri", "action", "deadlineUtc", "nowUtc"],
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "format": "uuid" },
    "auditId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "scopeId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "minLength": 1 },
    "targetUri": { "type": "string", "format": "uri" },
    "action": { "type": "string", "minLength": 1 },
    "deadlineUtc": { "type": "string", "format": "date-time" },
    "nowUtc": { "type": "string", "format": "date-time" },
    "requireRequestPermits": { "type": "boolean" },
    "useHttpRelay": { "type": "boolean" },
    "expectedAccess": { "enum": [null, "allow", "deny"] },
    "baselineUri": { "type": ["null", "string"], "format": "uri" },
    "sourceRoot": { "enum": [null, "/source"] },
    "sourceSha256": { "type": ["null", "string"], "pattern": "^[a-f0-9]{64}$" },
    "currentSourceInventoryJson": { "type": ["null", "string"], "maxLength": 32000 },
    "priorSourceInventoryJson": { "type": ["null", "string"], "maxLength": 32000 },
    "logoutObservation": {
      "type": ["null", "object"],
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["NotConfigured", "AnonymousNotDenied", "IdentityNotVerified", "LogoutNotAcknowledged", "ReplayUncertain", "FreshControlUnavailable", "FreshControlNotIndependent", "ConfigurationOrCredentialUnavailable", "OldBearerDenied", "OldBearerStillAccepted"] },
        "anonymousStatus": { "type": ["null", "integer"], "minimum": 0, "maximum": 599 },
        "baselineStatus": { "type": ["null", "integer"], "minimum": 0, "maximum": 599 },
        "logoutStatus": { "type": ["null", "integer"], "minimum": 0, "maximum": 599 },
        "replayStatus": { "type": ["null", "integer"], "minimum": 0, "maximum": 599 },
        "controlStatus": { "type": ["null", "integer"], "minimum": 0, "maximum": 599 },
        "cleanupStatus": { "type": ["null", "integer"], "minimum": 0, "maximum": 599 },
        "baselineIdentity": { "type": ["null", "boolean"] },
        "replayIdentity": { "type": ["null", "boolean"] },
        "controlIdentity": { "type": ["null", "boolean"] }
      }
    },
    "refreshObservation": {
      "type": ["null", "object"], "required": ["code"], "additionalProperties": false,
      "properties": {
        "code": { "enum": ["NotConfigured", "AnonymousNotDenied", "IdentityNotVerified", "InitialRefreshMissing", "InitialRefreshUncertain", "ActiveRefreshUncertain", "ReplayUncertain", "FamilyUncertain", "FreshControlUnavailable", "FreshControlNotIndependent", "Evaluated", "ConfigurationOrCredentialUnavailable"] },
        "baselineVerified": { "type": "boolean" }, "initialRefreshVerified": { "type": "boolean" },
        "rotated": { "type": ["null", "boolean"] }, "replayDenied": { "type": ["null", "boolean"] },
        "replayAccepted": { "type": ["null", "boolean"] }, "familyDenied": { "type": ["null", "boolean"] },
        "familyAccepted": { "type": ["null", "boolean"] }, "freshControlVerified": { "type": "boolean" },
        "expectFamilyRevocation": { "type": "boolean" },
        "steps": { "type": ["null", "array"], "maxItems": 16, "items": {
          "type": "object", "required": ["step", "status"], "additionalProperties": false,
          "properties": {
            "step": { "enum": ["anonymous", "baseline", "initial-refresh", "initial-identity", "active-refresh-baseline", "active-identity-baseline", "old-refresh-replay", "replay-identity", "active-family-refresh", "family-identity", "fresh-control-refresh", "fresh-control-identity", "cleanup-logout"] },
            "status": { "type": "integer", "minimum": 0, "maximum": 599 },
            "identityMatched": { "type": ["null", "boolean"] }, "invalidGrant": { "type": ["null", "boolean"] }
          }
        } }
      }
    },
    "enumerationObservation": {
      "type": ["null", "object"], "required": ["code"], "additionalProperties": false,
      "properties": {
        "code": { "enum": ["NotConfigured", "ReferenceUnverified", "Stopped", "ControlUnavailable", "Evaluated", "ConfigurationOrCredentialUnavailable"] },
        "uniformityExpected": { "type": "boolean" }, "referenceVerified": { "type": "boolean" }, "controlVerified": { "type": "boolean" },
        "knownAttempts": { "type": "integer", "minimum": 0, "maximum": 3 }, "nonexistentAttempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "statusConsistentWithinKnown": { "type": ["null", "boolean"] }, "statusConsistentWithinNonexistent": { "type": ["null", "boolean"] },
        "errorFieldConsistentWithinKnown": { "type": ["null", "boolean"] }, "errorFieldConsistentWithinNonexistent": { "type": ["null", "boolean"] },
        "statusDiffersBetweenGroups": { "type": ["null", "boolean"] }, "errorFieldDiffersBetweenGroups": { "type": ["null", "boolean"] },
        "stopped": { "type": "boolean" }, "stopReason": { "type": ["null", "string"], "maxLength": 64 },
        "steps": { "type": ["null", "array"], "maxItems": 16, "items": {
          "type": "object", "required": ["phase", "attempt", "status", "errorFieldPresent"], "additionalProperties": false,
          "properties": {
            "phase": { "enum": ["reference", "known", "nonexistent", "control"] },
            "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
            "status": { "type": "integer", "minimum": 0, "maximum": 599 },
            "errorFieldPresent": { "type": "boolean" }
          }
        } }
      }
    }
  }
}
